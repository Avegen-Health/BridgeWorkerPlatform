# .ebextensions/cloudwatch-setup.config
commands:
  01_install_cloudwatch_agent:
    command: yum install -y amazon-cloudwatch-agent

  02_configure_agent:
    command: |
      cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'EOF'
      {
        "metrics": {
          "metrics_collected": {
            "disk": {
              "measurement": ["used_percent"],
              "metrics_collection_interval": 300,
              "resources": ["/"]
            },
            "mem": {
              "measurement": ["mem_used_percent"],
              "metrics_collection_interval": 300
            }
          }
        },
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/log/tomcat/catalina.out",
                  "log_group_name": "/aws/elasticbeanstalk/bridgeworker-uat/var/log/tomcat/catalina",
                  "log_stream_name": "{instance_id}",
                  "timestamp_format": "%d-%b-%Y %H:%M:%S",
                  "multi_line_start_pattern": "^[0-9]{2}-[A-Za-z]+-[0-9]{4}"
                },
                {
                  "file_path": "/var/log/tomcat/localhost_access_log*.txt",
                  "log_group_name": "/aws/elasticbeanstalk/bridgeworker-uat/var/log/tomcat/access",
                  "log_stream_name": "{instance_id}",
                  "timestamp_format": "%d/%b/%Y:%H:%M:%S"
                },
                {
                  "file_path": "/var/log/tomcat/localhost.*.log",
                  "log_group_name": "/aws/elasticbeanstalk/bridgeworker-uat/var/log/tomcat/localhost",
                  "log_stream_name": "{instance_id}"
                }
              ]
            }
          }
        }
      }
      EOF

  03_start_cloudwatch_agent:
    command: |
      /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
        -a fetch-config \
        -m ec2 \
        -s \
        -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
