# Associate the dedicated ADDF-egress Elastic IP with this SingleInstance host.
#
# The EIP is allocated by the bridgeworker infra stack (AddfEgressEip) and its
# allocation id is injected as the ADDF_EGRESS_EIP_ALLOCATION_ID environment
# property. This command runs on every deploy AND on ASG-driven instance
# replacement, so the worker's outbound source IP toward Azure Blob storage
# stays stable and can be allowlisted on the staging storage-account firewall.
#
# Idempotent: --allow-reassociation lets a re-run (or a fresh instance) take
# over the same address cleanly. If the allocation id is unset (e.g. an env
# where ADDF egress is not configured) the step no-ops instead of failing the
# deploy.
container_commands:
  "50AssociateAddfEgressEip":
    command: |
      set -eo pipefail
      if [ -z "${ADDF_EGRESS_EIP_ALLOCATION_ID:-}" ]; then
        echo "ADDF_EGRESS_EIP_ALLOCATION_ID not set; skipping EIP association"
        exit 0
      fi
      TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
      INSTANCE_ID=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id)
      REGION=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/placement/region)
      echo "Associating EIP $ADDF_EGRESS_EIP_ALLOCATION_ID with $INSTANCE_ID in $REGION"
      aws ec2 associate-address \
        --allocation-id "$ADDF_EGRESS_EIP_ALLOCATION_ID" \
        --instance-id "$INSTANCE_ID" \
        --allow-reassociation \
        --region "$REGION"
